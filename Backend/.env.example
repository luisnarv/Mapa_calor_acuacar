# Única credencial obligatoria del backend.
OPENAI_API_KEY=sk-...

# Opcionales (valores por defecto entre paréntesis):
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2
# CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3100
# DATA_DIR=            # por defecto web/public/scr, la misma carpeta que lee el mapa
