# Conexión a PostgreSQL. Es la ÚNICA credencial del proyecto (solo lectura).
#   URI:  postgresql://USUARIO:CLAVE@HOST:5432/BASE
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE

# Opcionales. Sin definirlas se usan las del proyecto:
#   ETL_OUTPUT_DIR  -> web/public/scr
#   ETL_GEOJSON_DIR -> web/public/geojson
# ETL_OUTPUT_DIR=
# ETL_GEOJSON_DIR=
ETL_LOG_LEVEL=INFO
